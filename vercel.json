{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/boot.ts": {
      "maxDuration": 30,
      "includeFiles": [
        "db/**",
        "contracts/**",
        "api/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/trpc/:path*",
      "destination": "/api/boot.ts"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/boot.ts"
    }
  ]
}
