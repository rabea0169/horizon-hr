# ═══════════════════════════════════════════════════════════════
# إعدادات الإنتاج - Horizon HR
# ═══════════════════════════════════════════════════════════════

# ── Backend ─────────────────────────────────────────────────────
# معرّف التطبيق (يمكن أن يكون أي قيمة فريدة)
APP_ID=horizon-hr-production

# مفتاح سري للتوقيع (استخدم قيمة قوية جداً وفريدة)
# يمكنك توليد واحد باستخدام: openssl rand -base64 32
APP_SECRET=your_super_secret_key_here_change_this_in_production

# ── Database ───────────────────────────────────────────────────
# سلسلة اتصال MySQL
# الصيغة: mysql://username:password@host:port/database
# مثال: mysql://hr_user:strong_password@192.168.1.100:3306/horizon_hr
DATABASE_URL=mysql://hr_user:strong_password@localhost:3306/horizon_hr

# ── Frontend (exposed to browser via Vite) ──────────────────────
# عنوان خادم OAuth (اختياري)
VITE_KIMI_AUTH_URL=https://auth.kimi.com

# معرّف تطبيق OAuth (اختياري)
VITE_APP_ID=your_oauth_app_id

# ── Backend (Auth) ─────────────────────────────────────────────
# عنوان خادم OAuth (اختياري)
KIMI_AUTH_URL=https://auth.kimi.com

# عنوان منصة Kimi المفتوحة (اختياري)
KIMI_OPEN_URL=https://open.kimi.com

# ── Admin Role ──────────────────────────────────────────────────
# معرّف Union ID لمدير النظام (اختياري)
# هذا المستخدم سيحصل على دور "admin" عند أول تسجيل دخول
OWNER_UNION_ID=

# ── Node Environment ────────────────────────────────────────────
NODE_ENV=production

# ── Server Port ─────────────────────────────────────────────────
# المنفذ الذي سيستمع عليه الخادم
PORT=3000
