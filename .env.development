# ═══════════════════════════════════════════════════════════════
# إعدادات التطوير - Horizon HR
# ═══════════════════════════════════════════════════════════════

# ── Backend ─────────────────────────────────────────────────────
APP_ID=horizon-hr-dev

# مفتاح سري (يمكن أن يكون بسيطاً في التطوير)
APP_SECRET=dev_secret_key_change_in_production

# ── Database ───────────────────────────────────────────────────
# سلسلة اتصال MySQL للتطوير
# الصيغة: mysql://username:password@host:port/database
# مثال: mysql://hr_user:password@localhost:3306/horizon_hr
DATABASE_URL=mysql://hr_user:password@localhost:3306/horizon_hr

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=https://auth.kimi.com
VITE_APP_ID=dev_app_id

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=https://auth.kimi.com
KIMI_OPEN_URL=https://open.kimi.com

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=

# ── Node Environment ────────────────────────────────────────────
NODE_ENV=development

# ── Server Port ─────────────────────────────────────────────────
PORT=3000
